# ============================================================
# PRODUCTION ENVIRONMENT — BashAttack
# Copy to .env.production and fill in real values.
# NEVER commit .env.production — it is in .gitignore.
# ============================================================

# MongoDB — use your production Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bashattack-prod?retryWrites=true&w=majority

# Discord OAuth2 — register a SEPARATE app for production at discord.com/developers
DISCORD_CLIENT_ID=your_production_discord_client_id
DISCORD_CLIENT_SECRET=your_production_discord_client_secret
DISCORD_CALLBACK_URL=https://yourdomain.com/auth/discord/callback

# raid.gamernight.net Integration
RAID_API_URL=https://raid.gamernight.net/api
RAID_API_KEY=your_production_raid_api_key

# Session — generate with: openssl rand -hex 64
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# Server
NODE_ENV=production
PORT=3000

# Auto-save interval (ms)
AUTO_SAVE_INTERVAL=30000
